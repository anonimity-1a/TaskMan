{
  "name": "taskman",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n api,vite,app \"node server/dev.mjs\" \"vite --port 5173 --strictPort\" \"wait-on http://127.0.0.1:8787/api/health && wait-on http://localhost:5173 && electron .\"",
    "server": "node server/index.mjs",
    "build": "vite build",
    "build:extension": "vite build --config vite.extension.config.js",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  }
}
