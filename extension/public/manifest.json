{
  "manifest_version": 3,
  "name": "TaskMan",
  "version": "1.1.0",
  "description": "The TaskMan website in your browser side panel.",
  "action": {
    "default_title": "TaskMan"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
