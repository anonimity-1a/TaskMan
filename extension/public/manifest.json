{
  "manifest_version": 3,
  "name": "TaskMan",
  "version": "1.2.0",
  "description": "TaskMan in a floating window.",
  "action": {
    "default_title": "TaskMan"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://taskman.aamoghtech.org/*"]
}
